{
  "testEnvironment": "node",
  "verbose": true,
  "setupFiles": [],
  "testTimeout": 10000,
  "preset": "ts-jest",
  "transform": {
    "^.+\\.[jt]s?$": ["ts-jest", { "tsconfig": { "allowJs": true } }]
  },
  "transformIgnorePatterns": [
     "node_modules/(?!(uuid)/)"
  ],
  "testMatch": ["**/__tests__/**/*.test.[jt]s?(x)"],
  "reporters": [
    "default",
    [
      "jest-html-reporters",
      {
        "publicPath": "./test-report",
        "filename": "test_report.html",
        "pageTitle": "Test Report"
      }
    ]
  ]
}
